import type { OAuth2RequestError } from 'arctic';

export const SESSION = (hash: string) => {
	const prefix = `[validate '${hash}']`;
	const GENERAL = {
		CACHE_MISS_SESSION: `${prefix}: CACHE MISS (SESSION)`,
		CACHE_MISS_USER: `${prefix}: CACHE MISS (USER || TOKENS)`,
		EXPIRED: `${prefix}: TOKEN EXPIRED`,
		PERSIST: `${prefix}: TOKEN PERSIST`,
		PERSISTING_REVALIDATE: `${prefix}: PERSISTING FRESH VALIDATION`,
		PERSISTING_REFRESH: `${prefix}: PERSISTING FRESH TOKENS`,
		REQUIRE_REFRESH: `${prefix}: REFRESH OAUTH ACCESS`,
		REQUIRE_REVALIDATE: `${prefix}: REVALIDATE OAUTH ACCESS`,
	};

	const ERROR = {
		UNHANDLED: (err: Error) =>
			`${prefix}: OAUTH REFRESH UNKNOWN ERROR '${err.name}': '${err.message}'`,
		REFRESH_OAUTH2: (err: OAuth2RequestError) =>
			`${prefix}: OAUTH REFRESH OAuth2RequestError '${err.name}': '${err.message}'`,

		REVALIDATION_UNAUTHORIZED: `${prefix}: REVALIDATION RESPONSE STATUS = 401 (DURING REFRESH)`,
	};

	return {
		ERROR,
		GENERAL,
	};
};

export const HOOK = (routeId: string, userId?: string) => {
	let prefix = `[hook '${routeId}'`;
	prefix += userId ? `](${userId})` : ']';

	const GENERAL = {
		HOOK_START: `${prefix}: START HOOK`,
		UNSET_COOKIE: `${prefix}: NULL TOKEN ON CLIENT COOKIE`,
		UNDEFINED_COOKIE_VALUE: `${prefix}: '_session' EXISTS BUT CONTAINS AN UNDEFINED VALUE`,
		INVALID_SESSION: `${prefix}: CACHE MISS FOR TOKEN ON CLIENT COOKIE`,
		SESSION_OK: `${prefix}: SESSION TOKEN VALIDATED WITHOUT ISSUE`,
		HOOK_END: (reason: string) => `${prefix}: END HOOK (${reason})`,
	};

	const ERROR = {
		SETTING_COOKIE: (error: Error) =>
			`${prefix}: SET COOKIE UNKNOWN ERROR '${error.name}' - '${error.message}'`,
	};

	return {
		GENERAL,
		ERROR,
	};
};
